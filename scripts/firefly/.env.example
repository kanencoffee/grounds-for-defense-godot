# Adobe Firefly Services API credentials
# Get these from https://developer.adobe.com/console
#   1. Create a Project
#   2. Add API → Firefly Services API
#   3. Choose OAuth Server-to-Server credentials
#   4. Copy the Client ID and Client Secret here

ADOBE_CLIENT_ID=your-client-id-here
ADOBE_CLIENT_SECRET=your-client-secret-here

# Optional: remove.bg API key (enables --remove-bg flag)
# Get free at https://www.remove.bg/api  (50 free images/month)
REMOVE_BG_API_KEY=
